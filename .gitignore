# Data (keep raw sample but ignore large datasets & uploads)
data/processed/*
!data/processed/.gitkeep
data/raw/user_uploads/*
!data/raw/user_uploads/.gitkeep

# Generated output artifacts
outputs/forecasts/*
!outputs/forecasts/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
outputs/alerts/*
!outputs/alerts/.gitkeep

# OS / Editor
.DS_Store
.vscode/
.idea/

