# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# PyTest / Coverage
.pytest_cache/
.coverage
htmlcov/

# Model checkpoints & large binary dumps (keep directory structure and pre-trained package)
models/*.pt
!models/model_package.pt
models/*.keras
models/*.h5
models/*.pkl
models/*.joblib
